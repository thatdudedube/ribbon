rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member() { return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid)); }

    // Who is who. Only the server (claimMember) writes these.
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || member());
      allow write: if false;
    }
    // Phones that get reminders. Each person manages their own.
    match /tokens/{token} {
      allow create, update: if member() && request.resource.data.uid == request.auth.uid;
      allow delete: if member() && resource.data.uid == request.auth.uid;
      allow read: if false;
    }
    match /usage/{id} { allow read, write: if false; }

    // The shared lists: only the three members can read or change them.
    match /{col}/{id} {
      allow read, write: if member() && col in ['config','items','payments','profiles','proposals','prefs','picks','comments','feedback','meta'];
    }
  }
}
